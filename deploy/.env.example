# MILDO OS Cloud 환경변수 — deploy/.env로 복사해서 채운다 (cp .env.example .env && chmod 600 .env)
# .env는 비밀값이 들어가므로 git에 올리지 않는다(.gitignore). 값은 따옴표 없이 = 뒤에 그대로 쓴다.
# 서버 · 워커 공통 설정은 server/src/config.ts, 보안 · 운영 옵션은 server/src/http/security.ts가 읽는다.

# ───────── 필수 ─────────

# 외부에서 접속하는 주소 (초대 · 비밀번호 재설정 링크, 알림 메시지 링크). 끝에 / 없이.
APP_URL=https://ops.example.com

# 자격증명 암호화 키 — base64로 인코딩한 32바이트. 생성: openssl rand -base64 32
# 한 번 정한 뒤 바꾸려면 반드시 회전 도구를 쓴다(docs/OPERATIONS.md '비밀값 회전'). 잃어버리면 저장된 매체 자격증명을 복구할 수 없다.
ENCRYPTION_KEY=

# 쿠키 서명 비밀값 — 32자 이상. 생성: openssl rand -base64 48 | tr -d '\n'
SESSION_SECRET=

# 로컬 PostgreSQL(docker compose의 db 서비스) 계정. 비밀번호는 URL에 들어가므로 영숫자만: openssl rand -hex 24
POSTGRES_DB=mildo
POSTGRES_USER=mildo
POSTGRES_PASSWORD=

# DB 접속 URL — 비워 두면 compose가 위 POSTGRES_* 값으로 db 서비스 주소를 만든다.
# 관리형 DB를 쓸 때만 채운다. 예: postgres://mildo:<비밀번호>@<호스트>:5432/mildo?sslmode=require
DATABASE_URL=

# ───────── 첫 owner 계정 (docker compose run --rm app node server/dist/cli.mjs seed) ─────────

SEED_OWNER_EMAIL=owner@example.com
# 10자 이상, 영문 대소문자 · 숫자 · 기호 중 2가지 이상. 첫 로그인 뒤 화면에서 바꾸고 이 값은 지운다.
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=운영 책임자
# 데모 커넥션(TEST DATA 120일) 생성 — 시연 · 체험용 워크스페이스에서만 true. 실데이터 워크스페이스에 섞이지 않게 기본 false
SEED_DEMO_DATA=false
# pm · ae · client 데모 계정(@mildo.local) 생성 — 프로덕션에서는 false 유지
SEED_DEMO_USERS=false

# ───────── 서버 ─────────

# 컨테이너 안 포트 · 바인드 주소 (이미지 기본값: 8080, 0.0.0.0)
PORT=8080
HOST=0.0.0.0
# 로그인 세션 유지 시간(시간 단위, 기본 14일)
SESSION_TTL_HOURS=336
# 쿠키 Secure 속성 — 프로덕션 기본 true. HTTPS 없이 시험할 때만 false (false면 HSTS도 꺼진다)
SECURE_COOKIES=true
# 로그 수준: fatal · error · warn · info · debug · trace · silent
LOG_LEVEL=info
# 빌드된 프런트 폴더 (이미지 기본값 dist). 비우면 API만 서빙
# STATIC_DIR=dist
# 앱 · 워커가 시작할 때 마이그레이션 적용 — compose에서는 migrate 서비스가 하므로 compose가 false로 덮어쓴다
# MIGRATE_ON_START=true

# ───────── 워커 ─────────
# 워커(compose의 worker 서비스)는 반드시 하나 이상 떠 있어야 한다: 데모 시드 백필 · 예약 수집(07:00 전일 · 매시 10분 당일) ·
# CSV 업로드 반영 · 감지(10분마다) · SLA(1분마다) · 리포트 · 성과 측정 · 매체 반영 실행을 모두 워커가 처리한다.

# 워커 식별자 (하트비트 · 잡 잠금 표시). 비우면 compose가 worker-<컨테이너 호스트명>으로 정한다
WORKER_ID=
# 동시에 처리할 잡 수
WORKER_CONCURRENCY=2
# off면 예약 작업(07:00 전일 수집 · 매시 수집 · 10분 감지 · 리포트)을 돌리지 않는다 — 여러 워커 중 일부만 스케줄을 맡길 때.
# 모든 워커를 off로 두면 /api/ready가 degraded(no_scheduler)가 된다
SCHEDULER=on

# ───────── AI (서버 키 — 브라우저에 내려가지 않는다) ─────────

# 조직의 Anthropic API 키. 서버 환경변수에만 둔다 — 브라우저 · API 응답 · 로그로 나가지 않는다.
# 비우면 서버 모드 AI 기능이 꺼진다(화면에 '서버 AI 미설정' 표시, API는 503 ai_not_configured)
ANTHROPIC_API_KEY=
# 서버 AI 모델 (기본 claude-opus-5-5). 서버가 adaptive thinking으로 호출하므로 adaptive thinking을 지원하는 모델이어야 한다
ANTHROPIC_MODEL=claude-opus-5-5
# 비워 두면 공식 엔드포인트. 바꿀 때는 Anthropic 또는 신뢰하는 게이트웨이만 (조직 키가 그 주소로 간다)
# ANTHROPIC_BASE_URL=

# ───────── 메일 (초대 · 비밀번호 재설정 · 주간 리포트 · 알림) ─────────
# SMTP_HOST를 비우면 메일을 보내지 않는다(초대 링크는 화면에 표시된다)

SMTP_HOST=
SMTP_PORT=587
# 465 포트(SMTPS)면 true, 587(STARTTLS)이면 false
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MILDO OS <no-reply@example.com>

# ───────── 보안 · 운영 (server/src/http/security.ts, 0이면 해당 제한 끔) ─────────

# /api 전역 속도 제한: 클라이언트 IP(IPv6는 /64)당 창마다 허용 요청 수 · 창 길이(초). SSE는 제외
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_SEC=60
# 로그인 · 비밀번호 재설정 · 초대 수락: IP당 분당 허용 수
AUTH_RATE_LIMIT_MAX=20
# 같은 이메일 로그인 실패 허용 횟수 · 창(분) — 넘으면 그 계정 로그인을 창이 지날 때까지 막는다.
# 성공 로그인 · 비밀번호 재설정 뒤에는 새로 센다. 최근 30일 안에 그 계정으로 로그인에 성공한 IP는 그 IP의 실패만 센다
LOGIN_FAIL_MAX=10
LOGIN_FAIL_WINDOW_MIN=15
# 앞단 리버스 프록시 수 (Caddy · nginx · 로드밸런서 하나 = 1). 프록시 없이 8080을 직접 열면 0.
# Fastify trustProxy(req.ip → 감사 로그 ip · 라우트별 속도 제한)와 전역 속도 제한 · 로그인 잠금 · /api/ready 공개 범위가 모두 이 값을 쓴다.
# 프록시는 SSE(/api/w/*/events)와 AI 응답(/api/w/*/ai/messages)을 버퍼링하지 말고 읽기 제한 시간을 10분 이상으로 둔다(docs/OPERATIONS.md)
TRUST_PROXY_HOPS=1
# CSP connect-src에 더할 출처 (공백 구분, https:// · wss://만). 브라우저에서 외부 API를 직접 부르는 기능을 켤 때만
CSP_CONNECT_SRC_EXTRA=
# /api/ready: 워커 하트비트(60초마다) · 잡 처리 기록이 이 시간(분)보다 오래되면 degraded
READY_WORKER_STALE_MIN=15
# /api/ready: 예약 감지 잡(10분마다)이 이 시간(분) 동안 생기지 않으면 degraded(no_scheduler). 최소 11
READY_SCHEDULER_STALE_MIN=25
# /api/ready 세부 항목(워커 이름 · 워크스페이스 수 · 오류 문구)은 내부망 IP에만 보인다. 외부 감시에서 세부 항목이 필요하면
# 16자 이상 토큰을 넣고 x-ready-token 헤더로 보낸다. 생성: openssl rand -hex 24 (비우면 외부에는 판정만)
READY_TOKEN=
# 이 시간(ms)보다 오래 걸린 요청을 warn 로그로 남긴다
SLOW_REQUEST_MS=3000
# 종료(배포 · 재시작) 때 진행 중인 AI 응답이 끝나기를 기다리는 최대 시간(ms). compose app의 stop_grace_period(30s)보다 짧게
SHUTDOWN_STREAM_GRACE_MS=20000

# ───────── docker compose 전용 ─────────

# 사용할 이미지 (레지스트리에서 받을 때: ghcr.io/<조직>/mildo-os-cloud:<태그>)
MILDO_IMAGE=mildo-os-cloud:latest
# app 포트를 열 주소 · 포트. 기본 127.0.0.1(같은 VM의 프록시만 접속). 직접 노출하면 0.0.0.0 + TRUST_PROXY_HOPS=0
APP_BIND=127.0.0.1
APP_PORT=8080
# 이미지 빌드에서 타입 검사 생략(급한 핫픽스만)
SKIP_TYPECHECK=false
# 사내 SSL 검사 프록시처럼 TLS를 다시 서명하는 네트워크에서 npm ci가 실패하면 그 CA 파일 경로 (빌드에만 쓰이고 이미지에 남지 않는다).
# compose 빌드는 이 폴더(deploy/) 안의 파일만 읽을 수 있다: 예) cp /etc/ssl/corp-ca.crt deploy/corp-ca.crt → EXTRA_CA_FILE=./corp-ca.crt
EXTRA_CA_FILE=

# Caddy(HTTPS 자동 발급, docker compose --profile tls) — 도메인의 A 레코드가 이 VM을 가리켜야 한다
APP_DOMAIN=ops.example.com
ACME_EMAIL=ops@example.com

# 야간 백업 (backup 서비스, KST) · 보관 일수 · 백업 뒤 보관 기간 정리(deploy/tools/retention.sql) 실행 여부
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
RETENTION_ENABLED=false
