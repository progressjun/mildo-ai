{
  "name": "mildo-ax-agent",
  "private": true,
  "version": "1.0.0",
  "description": "수면밀도 퍼포먼스 AX 마케팅 에이전트 (Progress Media)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single && node scripts/postbuild-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sentinel": "tsx scripts/sentinel-cli.ts",
    "keywords": "tsx scripts/keyword-cli.ts",
    "e2e": "bash qa/run-e2e.sh",
    "server:dev": "tsx watch server/src/index.ts",
    "worker:dev": "tsx watch server/src/worker.ts",
    "server:build": "node scripts/build-server.mjs",
    "start": "node server/dist/index.mjs",
    "start:worker": "node server/dist/worker.mjs",
    "db:migrate": "tsx server/src/db/cli.ts migrate",
    "db:seed": "tsx server/src/db/cli.ts seed",
    "db:user": "tsx server/src/db/cli.ts user",
    "jobs:run": "tsx server/src/db/cli.ts run-jobs",
    "test:server": "vitest run --config vitest.server.config.ts",
    "pg:dev": "bash scripts/dev-pg.sh",
    "smoke:cloud": "bash scripts/smoke-cloud.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "bcryptjs": "^3.0.2",
    "croner": "^11.0.0",
    "fastify": "^5.12.8",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
