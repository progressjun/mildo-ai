{
  "name": "mildo-ax-agent",
  "private": true,
  "version": "1.0.0",
  "description": "수면밀도 퍼포먼스 AX 마케팅 에이전트 (Progress Media)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single && node scripts/postbuild-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sentinel": "tsx scripts/sentinel-cli.ts",
    "keywords": "tsx scripts/keyword-cli.ts",
    "e2e": "bash qa/run-e2e.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
